{
  "name": "instagram-mcp",
  "version": "1.0.0",
  "description": "Multi-Account Instagram Model Context Protocol (MCP) server for Feed Posts, Carousels, Reels/Videos, Stories, and Live Streaming",
  "type": "module",
  "main": "server.js",
  "bin": {
    "instagram-mcp": "./server.js",
    "instagram-login": "./login.js"
