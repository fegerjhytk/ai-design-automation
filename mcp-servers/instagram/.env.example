# Optional environment variable fallbacks for Instagram MCP Server
# You can also authenticate interactively via `npm run login` or pass credentials inline to MCP tools.

IG_USERNAME=your_default_instagram_username
IG_PASSWORD=your_default_instagram_password

# Optional JSON map of multiple accounts (username -> password) for automatic multi-account login
IG_ACCOUNTS_JSON={"account1":"pass1","account2":"pass2"}
